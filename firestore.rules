rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function signedIn() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    
    function role() {
      // It's safer to get the role from the custom claims, but we store it in users/{uid}
      // Assuming users/uid contains the role field
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.role in ['customer', 'professional'];
      allow update: if isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow delete: if false;
    }

    match /professionals/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid);
      allow update: if (isOwner(uid) && 
                      (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['stats', 'skillStats', 'verificationNote']) &&
                       (request.resource.data.verificationStatus == resource.data.verificationStatus || 
                        (resource.data.verificationStatus in ['unsubmitted', 'rejected'] && request.resource.data.verificationStatus == 'pending'))
                      )) || isAdmin() || 
                      // allow customer to update stats during review
                      (signedIn() && role() == 'customer' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats', 'skillStats', 'updatedAt']));
      allow delete: if false;
    }

    match /jobs/{jobId} {
      allow read, write: if signedIn() && isOwner(resource.data.customerId) || (request.method == 'create' && isOwner(request.resource.data.customerId));
    }

    function validTransition(old, newVal, byRole) {
      // 6-step canonical workflow
      return (old == 'REQUEST_CREATED'       && newVal == 'PROFESSIONAL_ACCEPTED' && byRole == 'professional') ||
             (old == 'REQUEST_CREATED'       && newVal == 'rejected'              && byRole == 'professional') ||
             (old == 'REQUEST_CREATED'       && newVal == 'cancelled'             && byRole == 'customer')     ||
             (old == 'PROFESSIONAL_ACCEPTED' && newVal == 'CUSTOMER_CONFIRMED'    && byRole == 'customer')     ||
             (old == 'PROFESSIONAL_ACCEPTED' && newVal == 'cancelled'             && byRole == 'customer')     ||
             (old == 'CUSTOMER_CONFIRMED'    && newVal == 'PROFESSIONAL_ARRIVED'  && byRole == 'professional') ||
             (old == 'PROFESSIONAL_ARRIVED'  && newVal == 'JOB_STARTED'           && byRole == 'professional') ||
             (old == 'JOB_STARTED'           && newVal == 'JOB_COMPLETED'         && byRole == 'customer');
    }

    match /bookings/{bookingId} {
      // Customer creates request — status must be REQUEST_CREATED, amount must NOT be set by customer
      allow create: if signedIn() && isOwner(request.resource.data.customerId) &&
        request.resource.data.status == 'REQUEST_CREATED' &&
        !('estimatedCharge' in request.resource.data);

      allow read: if signedIn() && (isOwner(resource.data.customerId) || isOwner(resource.data.professionalId) || isAdmin());

      allow update: if signedIn() && (
        // ── CUSTOMER actions ──
        (isOwner(resource.data.customerId) && (
          // Customer confirms (PROFESSIONAL_ACCEPTED → CUSTOMER_CONFIRMED) + timestamp
          (validTransition(resource.data.status, request.resource.data.status, 'customer') &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['status', 'updatedAt', 'statusHistory', 'customerConfirmedAt', 'jobCompletedAt'])) ||
          // Customer cancels
          (request.resource.data.status == 'cancelled' &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'statusHistory'])) ||
          // Customer marks reviewed after completion
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewed', 'updatedAt']) &&
           request.resource.data.reviewed == true && resource.data.status == 'JOB_COMPLETED')
        )) ||
        // ── PROFESSIONAL actions ──
        (isOwner(resource.data.professionalId) && (
          // Professional accepts + sets amount/date/time (REQUEST_CREATED → PROFESSIONAL_ACCEPTED)
          (validTransition(resource.data.status, request.resource.data.status, 'professional') &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['status', 'updatedAt', 'statusHistory',
              'estimatedCharge', 'scheduledDate', 'timeSlot',
              'professionalArrivedAt', 'jobStartedAt']) &&
           (!('estimatedCharge' in request.resource.data) ||
            request.resource.data.estimatedCharge == null ||
            request.resource.data.estimatedCharge >= 0))
        ))
      );

      allow delete: if false;
    }

    match /reviews/{bookingId} {
      allow read: if signedIn();
      allow create: if signedIn() && 
                    isOwner(request.resource.data.customerId) &&
                    getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.reviewed == true;
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow create: if signedIn() && isOwner(request.resource.data.fromUid);
      allow read: if signedIn() && isOwner(resource.data.toUid);
      allow update: if signedIn() && isOwner(resource.data.toUid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signedIn() && isOwner(resource.data.toUid);
    }

    match /images/{imageId} {
      allow create: if signedIn() && isOwner(request.resource.data.ownerId) && request.resource.data.base64.size() < 280000; // ~200KB base64
      allow read: if signedIn() && (
        resource.data.purpose == 'avatar' || 
        (resource.data.purpose == 'certificate' && (isOwner(resource.data.ownerId) || isAdmin())) ||
        ((resource.data.purpose == 'jobPhoto' || resource.data.purpose == 'completion') && 
          (
            isOwner(resource.data.ownerId) || 
            (resource.data.bookingId != null && 
              (isOwner(get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.customerId) || 
               isOwner(get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.professionalId)))
          )
        )
      );
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
